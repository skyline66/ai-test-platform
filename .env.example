# 复制成 .env 后按需填写。所有项都有默认值，留空也能跑（离线降级模式）。

# ---------- 被测环境 ----------
# 留空 = 使用内置 demo_app（utils/demo_server.py 临时起一个本地站点，离线可跑）
# 填真实地址 = 用例直接打真实环境，例如 https://your-shop.example
ATP_BASE_URL=

# ---------- LLM（可选）----------
# 留空则平台进入「离线降级」：起草走模板、归因走规则。
# 填任意 OpenAI 兼容端点即可（DeepSeek / Qwen / vLLM / Ollama 皆可）
ATP_LLM_BASE_URL=
ATP_LLM_API_KEY=
ATP_LLM_MODEL=deepseek-chat

# ---------- 产物目录 ----------
ATP_ARTIFACTS=artifacts
ATP_DB_PATH=artifacts/atp.db

# ---------- 调度 ----------
# 0 = 关闭定时冒烟；1 = 服务启动后按 interval 自动跑
ATP_SCHEDULE_ENABLED=0
ATP_SCHEDULE_INTERVAL=3600
ATP_SCHEDULE_SELECTOR=-m smoke

# ---------- 服务 ----------
ATP_HOST=127.0.0.1
ATP_PORT=8077